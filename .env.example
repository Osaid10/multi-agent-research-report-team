# ---------------------------------------------------------------------------
# There is no model API key here. Every agent runs through the `claude` CLI on
# this machine's logged-in session -- run `claude` once interactively and sign
# in, and the whole team works. (Never pass --bare: it forces API-key-only auth
# and ignores the OAuth session.)
# ---------------------------------------------------------------------------

# Tracing. Free account at https://smith.langchain.com -> Settings -> API keys.
# Without it the graph still runs; you just lose the trace view, which is the
# single most useful tool for debugging a supervisor that misroutes.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-report-team

# --- optional overrides ----------------------------------------------------
# Per-role model. Any CLI alias (haiku/sonnet/opus) or a full model id.
# This is how the eval sweeps model mixes without touching code.
# REPORTTEAM_MODEL_SUPERVISOR=haiku
# REPORTTEAM_MODEL_PLANNER=haiku
# REPORTTEAM_MODEL_RESEARCHER=haiku
# REPORTTEAM_MODEL_WRITER=sonnet
# REPORTTEAM_MODEL_CRITIC=sonnet

# How many times the critic may bounce a draft before we ship the best one.
# REPORTTEAM_MAX_REVISIONS=2
# LangGraph's backstop. Hitting it means a routing loop -- fix the prompt.
# REPORTTEAM_RECURSION_LIMIT=40
# Concurrent researcher subprocesses in Phase 5.
# REPORTTEAM_CONCURRENCY=4
# REPORTTEAM_CLI_TIMEOUT=300

# Only if the CLI is not on PATH.
# REPORTTEAM_CLAUDE_BIN=
